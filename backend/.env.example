# Copy to .env and set your own local values. Never commit .env or API keys.
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=cyber_threat_intelligence
# Set this to a reachable replica-set URI to launch Chapter 10 from local FastAPI.
MONGO_URI_CH10=
# Set this to a reachable mongos URI to enable the live Chapter 11 sharding lab.
MONGO_URI_CH11=

# Optional MISP event synchronization
MISP_URL=https://your-misp.example
MISP_API_KEY=
MISP_VERIFY_TLS=true

# Optional VirusTotal indicator lookup (never used for automatic file upload)
VIRUSTOTAL_API_KEY=
