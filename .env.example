# Copy this to .env. These defaults point to the published Riyansh24 images.
LAB_IMAGE=riyansh24/aegis_threatintelligence:latest
LAB_IMAGE_CH7=riyansh24/mongodb-labs-ch7:2.0
LAB_IMAGE_CH8=riyansh24/mongodb-labs-ch8:2.0
LAB_IMAGE_CH9=riyansh24/mongodb-labs-ch9:2.0
LAB_IMAGE_CH10=riyansh24/mongodb-labs-ch10:1.0
LAB_IMAGE_CH11=riyansh24/mongodb-labs-ch11:1.0
DATABASE_NAME=cyber_threat_intelligence

# Chapter 16 optional databases. Set a private Neo4j password (8+ chars) before start.
LAB16_NEO4J_PASSWORD=
LAB16_CASSANDRA_CONTACT_POINTS=localhost
LAB16_CASSANDRA_KEYSPACE=aegis_intel
LAB16_NEO4J_URI=bolt://localhost:7687
LAB16_ACCOUNTS_COLLECTION=lab10_accounts
LAB16_TRANSACTIONS_COLLECTION=lab10_transfer_history

# Chapter 17. Keys stay on the backend and are never sent to browser JavaScript.
# Configure an embeddings key to index/use semantic search. The LLM key is optional;
# without it Ask CTI returns clearly labelled extractive answers.
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LAB17_VECTOR_INDEX=ask_vector_index
LAB17_MIN_RELEVANCE=0.20

# Optional integrations; leave blank if you do not use them.
VIRUSTOTAL_API_KEY=
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true
